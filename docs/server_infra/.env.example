# TerraPoint VM / VPS Environment Configuration
# Salin file ini menjadi .env sebelum menjalankan docker compose

# Database PostgreSQL
POSTGRES_DB=terrapoint
POSTGRES_USER=terrapoint_user
POSTGRES_PASSWORD=terrapoint_secure_pass_2026

# Backend REST API
PORT=3000
JWT_SECRET=terrapoint_jwt_secret_morowali_production_2026

# Host Domain / Public IP VM
BASE_URL=http://localhost
# Atau jika menggunakan domain VPS dengan SSL:
# BASE_URL=https://terrapoint.perusahaan-tambang.co.id
